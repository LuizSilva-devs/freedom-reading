# Copie para .env e ajuste.
DATABASE_URL=postgresql+psycopg://freedom:freedom@localhost:5432/freedom

# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave-por-uma-com-pelo-menos-32-caracteres
JWT_EXPIRE_MINUTES=10080

# Proteção contra tentativas de senha em massa (por IP)
LOGIN_ATTEMPTS_PER_5MIN=10
REGISTRATIONS_PER_HOUR=20

# pg_trgm word_similarity (0..1). Calibre com scripts/test_matching.py.
SIMILARITY_THRESHOLD=0.45
MIN_EXCERPT_CHARS=25

READER_PAGE_CHARS=2500

# Tradução automática no leitor: mymemory (grátis) | libretranslate | aws | none
TRANSLATION_PROVIDER=mymemory
# Com um e-mail, o MyMemory libera 50 mil caracteres/dia (sem e-mail: ~5 mil).
TRANSLATION_EMAIL=
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=
# AWS_REGION=us-east-1

# ---------------- Conta: e-mails de confirmação e "esqueci minha senha" ----------------
# Endereço público do site, usado nos links dos e-mails (no EC2: http://SEU-IP:8000)
APP_URL=http://localhost:8000
# console = só imprime o e-mail no terminal | smtp | ses
EMAIL_PROVIDER=console
EMAIL_FROM=Freadom Reading <no-reply@freedom.local>
# SMTP (ex.: Gmail com "senha de app": smtp.gmail.com, porta 587)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=voce@gmail.com
# SMTP_PASSWORD=senha-de-app
EMAIL_REQUESTS_PER_HOUR=5
